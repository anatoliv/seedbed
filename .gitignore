# Fetched model documentation. Regenerated by `promptlib refresh --fetch`;
# machine-local so a stale cache on one Mac never travels to another.
.cache/

# Finder metadata. Two of these were tracked from the first app commit, which
# is why a new one in another directory read as the only untracked file in the
# tree and stopped a publish: the guard is right, the repo was wrong.
.DS_Store

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Secrets. API keys live in the login Keychain, never in the tree.
*.local

# Copy counts: machine-local by design (see promptlib/usage.py)
.usage.json

# Values entered for prompt placeholders: machine-local (see promptlib/variables.py)
.variables.json


# Agent worktrees. The harness creates git checkouts under .claude/worktrees/,
# and a bare `git add -A` commits them as embedded gitlinks that clone as empty
# directories. Happened once on 2026-09-07 while two agents were mid-flight.
.claude/
